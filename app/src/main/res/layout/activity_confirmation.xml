<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF0E6"
    android:padding="16dp">

    <TextView
        android:id="@+id/confirmationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thank You!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:paddingBottom="20dp"/>

    <TextView
        android:id="@+id/confirmationMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your order has been placed successfully."
        android:textSize="18sp"
        android:layout_below="@id/confirmationTitle"
        android:layout_centerHorizontal="true"
        android:paddingBottom="12dp"/>

    <!-- STEP2> Two new rows go here, ABOVE orderTotalText, so the order reads
         STEP2> Subtotal / Tax / Total:
         STEP2>
         STEP2> <TextView
         STEP2>     android:id="@+id/orderSubtotalText"
         STEP2>     android:layout_width="wrap_content"
         STEP2>     android:layout_height="wrap_content"
         STEP2>     android:text="Subtotal: $0.00"
         STEP2>     android:textSize="16sp"
         STEP2>     android:layout_below="@id/confirmationMessage"
         STEP2>     android:layout_centerHorizontal="true"
         STEP2>     android:paddingBottom="4dp"/>
         STEP2>
         STEP2> <TextView
         STEP2>     android:id="@+id/orderTaxText"
         STEP2>     android:layout_width="wrap_content"
         STEP2>     android:layout_height="wrap_content"
         STEP2>     android:text="Tax (10.75%): $0.00"
         STEP2>     android:textSize="16sp"
         STEP2>     android:layout_below="@id/orderSubtotalText"
         STEP2>     android:layout_centerHorizontal="true"
         STEP2>     android:paddingBottom="8dp"/>
         STEP2>
         STEP2> ...and orderTotalText below must then change its anchor from
         STEP2> layout_below="@id/confirmationMessage" to layout_below="@id/orderTaxText".
         STEP2> RelativeLayout positions by explicit anchor, not document order — forget this
         STEP2> and the three rows stack on top of each other. -->

    <TextView
        android:id="@+id/orderTotalText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Total: $0.00"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_below="@id/confirmationMessage"
        android:layout_centerHorizontal="true"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/pickupLocationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pickup at: 123 Coffee Lane, Hayward CA"
        android:textSize="16sp"
        android:layout_below="@id/orderTotalText"
        android:layout_centerHorizontal="true"/>

</RelativeLayout>
